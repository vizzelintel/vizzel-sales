# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.your-project-ref.supabase.co:5432/postgres
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Google Calendar (service account)
GOOGLE_CALENDAR_CREDENTIALS_JSON={"type":"service_account","client_email":"...","private_key":"...","token_uri":"https://oauth2.googleapis.com/token"}
GOOGLE_CALENDAR_ID=primary

# LINE Login
LINE_CHANNEL_ID=your-line-channel-id
LINE_CHANNEL_SECRET=your-line-channel-secret

# Server
PORT=8080
GIN_MODE=debug

# CORS — comma-separated additional allowed origins
ALLOWED_ORIGINS=https://your-frontend.com
