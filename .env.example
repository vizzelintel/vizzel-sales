# Production URLs (reference)
# Frontend: https://vizzelintel.github.io/vizzel-sales-frontend/
# Backend API: https://vizzel-sales-api.fly.dev/api/v1

# Required envs (canonical names)
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.your-project-ref.supabase.co:5432/postgres
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

LARK_APP_ID=your-lark-app-id
LARK_APP_SECRET=your-lark-app-secret
LARK_BASE_APP_TOKEN=your-lark-bitable-app-token
LARK_TABLE_ID=your-lark-table-id

LIFF_ID=your-liff-id
LINE_CHANNEL_SECRET=your-line-channel-secret

# Optional (Google Calendar integration used by appointment statuses)
GOOGLE_CALENDAR_CREDENTIALS_JSON={"type":"service_account","client_email":"...","private_key":"...","token_uri":"https://oauth2.googleapis.com/token"}
GOOGLE_CALENDAR_ID=primary

# Server
PORT=8080
GIN_MODE=release
