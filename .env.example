# Vizzel Sales API — environment template
# Copy to .env for local dev. Production: deploy/.env.production (not committed).

# --- Database (required) ---
DATABASE_URL=postgres://vizzel:vizzel_dev@127.0.0.1:5433/vizzel_sales?sslmode=disable
# Legacy (deprecated): SUPABASE_DB_URL=

# --- Auth (required) ---
JWT_SECRET=replace-with-random-secret-min-32-chars
LINE_CHANNEL_SECRET=your-line-channel-secret
# Optional: long-lived token from LINE Console. If unset, API issues token via LIFF channel id + secret.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_ID=
LIFF_ID=your-liff-id

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=https://staging-sale.vizzeltrack.com,https://sale.vizzeltrack.com,https://vizzelintel.github.io

# --- File storage (self-host) ---
FILE_STORAGE_DRIVER=local
FILE_STORAGE_PATH=./data/docs

# --- Lark ---
LARK_APP_ID=your-lark-app-id
LARK_APP_SECRET=your-lark-app-secret
LARK_BASE_APP_TOKEN=
LARK_TABLE_ID=
LARK_DEV_TASKS_TABLE_ID=
LARK_COL_DETAIL_NOTE=รายละเอียดเพิ่มเติม
LARK_NOTIFY_CHAT_ID=
LARK_NOTIFY_ENABLED=true
LARK_WEBHOOK_ENABLED=true
LARK_EVENT_VERIFY_TOKEN=replace-with-random-verify-token
LARK_ENCRYPT_KEY=
LARK_WIKI_NODE_TOKEN=
# Pull latest CRM row when user opens project in app (fallback if webhook push delayed)
LARK_PULL_ON_VIEW=true

# --- Notifications ---
NOTIFY_ENABLED=true
NOTIFY_EXTRA_EMAILS=

# --- Email OTP ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@your-domain.com
SMTP_FROM_NAME=Vizzel Sales
EMAIL_OTP_SECRET=replace-with-random-secret
EMAIL_OTP_DEBUG=false

# --- Google Calendar (optional) ---
GOOGLE_CALENDAR_CREDENTIALS_JSON=
GOOGLE_CALENDAR_ID=primary

# --- Server ---
PORT=8080
GIN_MODE=debug

# Production URLs (reference)
# Staging API:  https://staging-sale-api.vizzeltrack.com
# Production API: https://sale-api.vizzeltrack.com
# Staging FE:   https://staging-sale.vizzeltrack.com
# Production FE: https://sale.vizzeltrack.com
