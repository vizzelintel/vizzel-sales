# Copy to deploy/.env.production on server — never commit secrets.

POSTGRES_USER=vizzel_sales
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=vizzel_sales

JWT_SECRET=CHANGE_ME_RANDOM_64_CHARS
LINE_CHANNEL_SECRET=your-line-channel-secret
# Optional: long-lived token from LINE Console. If unset, API issues token via LIFF channel id + secret.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_ID=
LIFF_ID=your-liff-id

CORS_ORIGINS=https://sale.vizzeltrack.com

LARK_APP_ID=
LARK_APP_SECRET=
LARK_BASE_APP_TOKEN=
LARK_WIKI_NODE_TOKEN=
LARK_TABLE_ID=
LARK_NOTIFY_CHAT_ID=
LARK_NOTIFY_ENABLED=true
LARK_WEBHOOK_ENABLED=true
LARK_EVENT_VERIFY_TOKEN=
LARK_ENCRYPT_KEY=
# Primary Lark→App sync fallback until webhook push verified in prod Console
LARK_PULL_ON_VIEW=true

NOTIFY_ENABLED=true
NOTIFY_EXTRA_EMAILS=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Vizzel Sales
EMAIL_OTP_SECRET=CHANGE_ME_RANDOM

FILE_STORAGE_DRIVER=local
FILE_STORAGE_PATH=/data/docs

GOOGLE_CALENDAR_CREDENTIALS_JSON=
GOOGLE_CALENDAR_ID=primary
