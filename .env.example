# Production URLs (reference)
# Frontend: https://vizzelintel.github.io/vizzel-sales-frontend/
# Backend API: https://vizzel-sales-api.fly.dev/api/v1

# Required envs (canonical names)
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.your-project-ref.supabase.co:5432/postgres
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

LARK_APP_ID=your-lark-app-id
LARK_APP_SECRET=your-lark-app-secret
# Bitable app_token for API (NOT the Base workspace id from …/base/workspace/…):
# - Wiki table URL …/wiki/{THIS_TOKEN}?table=tbl… → use {THIS_TOKEN} as LARK_BASE_APP_TOKEN
# - Standalone Base …/base/{APP_TOKEN}?table=tbl… → use {APP_TOKEN} (differs from workspace id)
LARK_BASE_APP_TOKEN=Es4NwqP2OimAqZkUADOjVuSip4c
LARK_TABLE_ID=tblhmbd8fUOB5GGv
# Optional: resolve app_token via Wiki API (needs wiki:node:read scope). Usually unnecessary if token above is set.
LARK_WIKI_NODE_TOKEN=

LIFF_ID=your-liff-id
LINE_CHANNEL_SECRET=your-line-channel-secret

# Optional (Google Calendar integration used by appointment statuses)
GOOGLE_CALENDAR_CREDENTIALS_JSON={"type":"service_account","client_email":"...","private_key":"...","token_uri":"https://oauth2.googleapis.com/token"}
GOOGLE_CALENDAR_ID=primary

# Optional (calendar invite email + OTP verification)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=no-reply@your-domain.com
SMTP_FROM_NAME=Vizzel Sales
EMAIL_OTP_SECRET=replace-with-random-secret
EMAIL_OTP_DEBUG=false

# Server
PORT=8080
GIN_MODE=release
